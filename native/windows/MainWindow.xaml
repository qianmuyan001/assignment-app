<Window
    x:Class="AssignmentNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AssignmentNative"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Assignments">

    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        IsPaneToggleButtonVisible="True"
        IsTitleBarAutoPaddingEnabled="True"
        OpenPaneLength="230"
        CompactPaneLength="52"
        IsPaneOpen="True"
        PaneDisplayMode="Left"
        SelectionChanged="Navigation_SelectionChanged">

        <NavigationView.Resources>
            <DataTemplate x:Key="CandidateTemplate"
                          x:DataType="local:AssignmentCandidate">
                <Border Style="{StaticResource TaskCardStyle}" Margin="0,0,0,8">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind CourseDisplay}"
                                   FontSize="12" Opacity="0.62"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind DueDisplay}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind Description}"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   Opacity="0.62"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </NavigationView.Resources>

        <NavigationView.PaneHeader>
            <StackPanel Spacing="2" Margin="8,10,0,12">
                <TextBlock x:Uid="AppName" Text="Assignments" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Uid="AppSubtitle" Text="Local task workspace" Opacity="0.58" FontSize="12"/>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.PaneFooter>
            <Button x:Name="NavigationStyleButton" x:Uid="NavigationStyleButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="NavigationStyle_Click"
                    ToolTipService.ToolTip="Use compact navigation"
                    AutomationProperties.Name="Use compact navigation">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE700;" FontSize="16"/>
                    <TextBlock x:Name="NavigationStyleLabel" x:Uid="NavigationStyleLabel"
                               Text="Compact navigation"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </NavigationView.PaneFooter>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavAll" Content="All Assignments" Tag="all" Icon="AllApps"/>
            <NavigationViewItem x:Uid="NavToday" Content="Today" Tag="today" Icon="CalendarDay"/>
            <NavigationViewItem x:Uid="NavWeek" Content="This Week" Tag="week" Icon="CalendarWeek"/>
            <NavigationViewItem x:Uid="NavOverdue" Content="Overdue" Tag="overdue" Icon="Important"/>
            <NavigationViewItem x:Uid="NavCompleted" Content="Completed" Tag="completed" Icon="Accept"/>
            <NavigationViewItemSeparator/>
            <NavigationViewItem x:Uid="NavSources" Content="Sources" Tag="sources" Icon="Link"/>
        </NavigationView.MenuItems>

        <Grid x:Name="RootGrid"
              Loaded="RootGrid_Loaded"
              SizeChanged="RootGrid_SizeChanged">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="F"
                                     Modifiers="Control"
                                     Invoked="Find_Invoked"/>
            </Grid.KeyboardAccelerators>
            <Grid x:Name="AssignmentPanel" Padding="24,18,24,22" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="PageTitle" x:Uid="PageTitle" Text="All Assignments"
                                   FontSize="28" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="AssignmentCount" Opacity="0.62"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddAssignmentButton" x:Uid="AddAssignmentButton"
                                Content="Add assignment"
                                Click="AddAssignment_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,8"
                                IsEnabled="False"/>
                        <Button x:Name="ManageOrganizationButton" x:Uid="ManageOrganizationButton"
                                Content="Courses &amp; tags"
                                Click="ManageOrganization_Click"
                                Padding="14,8"/>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorBar" x:Uid="ErrorBar"
                         Grid.Row="1"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Error"
                         Title="Could not load assignments"/>

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="880">
                        <Grid x:Name="SearchChrome"
                              Width="40"
                              VerticalAlignment="Bottom">
                            <Button x:Name="SearchToggleButton" x:Uid="SearchToggleButton"
                                    Width="40"
                                    Height="32"
                                    Click="SearchToggle_Click"
                                    ToolTipService.ToolTip="Search assignments"
                                    AutomationProperties.Name="Search assignments">
                                <FontIcon Glyph="&#xE721;" FontSize="16"/>
                            </Button>
                            <Grid x:Name="SearchEditor"
                                  Visibility="Collapsed"
                                  ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox"
                                                PlaceholderText="Search title, course, or description"
                                                TextChanged="SearchBox_TextChanged"
                                                PreviewKeyDown="SearchBox_KeyDown"
                                                QueryIcon="Find"
                                                AutomationProperties.Name="Search assignments"/>
                                <Button x:Name="SearchCloseButton" x:Uid="SearchCloseButton"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="32"
                                        Click="SearchClose_Click"
                                        ToolTipService.ToolTip="Clear and close search"
                                        AutomationProperties.Name="Clear and close search">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Grid>
                        <ComboBox x:Name="StatusFilterBox" x:Uid="StatusFilterBox"
                                  Width="150"
                                  Header="Status"
                                  SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem x:Uid="StatusAll" Content="All statuses" Tag="all"/>
                            <ComboBoxItem x:Uid="StatusTodo" Content="To do" Tag="todo"/>
                            <ComboBoxItem x:Uid="StatusInProgress" Content="In progress" Tag="in_progress"/>
                            <ComboBoxItem x:Uid="StatusDone" Content="Done" Tag="done"/>
                        </ComboBox>
                        <ComboBox x:Name="CourseFilterBox" x:Uid="CourseFilterBox"
                                  Width="180"
                                  Header="Course"
                                  SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged"/>
                        <ComboBox x:Name="PriorityFilterBox" x:Uid="PriorityFilterBox"
                                  Width="150"
                                  Header="Priority"
                                  SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem x:Uid="PriorityAll" Content="All priorities" Tag="all"/>
                            <ComboBoxItem x:Uid="PriorityHigh" Content="High" Tag="high"/>
                            <ComboBoxItem x:Uid="PriorityMedium" Content="Medium" Tag="medium"/>
                            <ComboBoxItem x:Uid="PriorityLow" Content="Low" Tag="low"/>
                        </ComboBox>
                        <ComboBox x:Name="SortBox" x:Uid="SortBox"
                                  Width="170"
                                  Header="Sort"
                                  SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem x:Uid="SortDueDate" Content="Due date" Tag="due_date"/>
                            <ComboBoxItem x:Uid="SortPriority" Content="Priority" Tag="priority"/>
                        </ComboBox>
                        <Button x:Uid="ClearFiltersButton" Content="Clear"
                                AutomationProperties.Name="Clear filters"
                                VerticalAlignment="Bottom"
                                Click="ClearFilters_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3">
                    <ListView x:Name="AssignmentList" x:Uid="AssignmentList"
                              AutomationProperties.Name="Assignments"
                              ItemsSource="{x:Bind AssignmentRows}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TaskRowViewModel">
                                <Border Style="{StaticResource TaskCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{x:Bind AccentBrush}" CornerRadius="2"/>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind CourseName}"
                                                           Foreground="{x:Bind AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="1"
                                                        Background="{x:Bind AccentBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2">
                                                    <TextBlock Text="{x:Bind StatusDisplay}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind DueDisplay}"
                                                       Foreground="{x:Bind AccentBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Visibility="{x:Bind ProfessionalVisibility}"
                                                        Spacing="7">
                                                <TextBlock Text="{x:Bind DescriptionDisplay}"
                                                           Opacity="0.70"
                                                           MaxLines="4"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="{x:Bind PriorityBrush}"
                                                            CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="{x:Bind PriorityDisplay}"
                                                                   Foreground="White"
                                                                   FontSize="11"/>
                                                    </Border>
                                                    <Button x:Uid="OpenSourceLinkButton" Content="Open source link"
                                                            Tag="{x:Bind Link}"
                                                            Visibility="{x:Bind LinkVisibility}"
                                                            Click="OpenTaskLink_Click"
                                                            Padding="8,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8"
                                                        Margin="0,4,0,0">
                                                <Button x:Uid="EditAssignmentButton" Content="Edit"
                                                        Tag="{x:Bind Id}"
                                                        Click="EditAssignment_Click"/>
                                                <Button x:Uid="MarkDoneButton" Content="Mark done"
                                                        Tag="{x:Bind Id}"
                                                        Visibility="{x:Bind CompleteButtonVisibility}"
                                                        Click="Done_Click"/>
                                                <Button x:Uid="DeleteAssignmentButton" Tag="{x:Bind Id}"
                                                        Click="Delete_Click"
                                                        ToolTipService.ToolTip="Delete assignment"
                                                        AutomationProperties.Name="Delete assignment">
                                                    <FontIcon Glyph="&#xE74D;"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE73E;" FontSize="36" Opacity="0.5"/>
                        <TextBlock x:Name="EmptyStateTitle" x:Uid="EmptyStateTitle"
                                   Text="No assignments here"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateMessage" x:Uid="EmptyStateMessage"
                                   Text="Add an assignment or change the filters."
                                   Opacity="0.62"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="420"/>
                    </StackPanel>

                    <StackPanel x:Name="LoadingState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <ProgressRing IsActive="True" Width="36" Height="36"/>
                        <TextBlock x:Uid="LoadingAssignments" Text="Loading assignments…" Opacity="0.68"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="SourcePanel"
                  Visibility="Collapsed"
                  Padding="24,18,24,20"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="SourceConnectorTitle" Text="Secure Source Connector"
                                   FontSize="28" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Uid="SourceConnectorSubtitle" Text="Sign in first, then let the local model extract assignments."
                                   Opacity="0.58" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xEA18;" Foreground="ForestGreen"/>
                        <TextBlock x:Uid="LocalOnly" Text="Local only" Foreground="ForestGreen"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled">
                    <Grid ColumnSpacing="10" MinWidth="720">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceNameBox" x:Uid="SourceNameBox" PlaceholderText="Source name · e.g. Canvas"/>
                        <TextBox x:Name="CourseHintBox" x:Uid="CourseHintBox" Grid.Column="1"
                                 PlaceholderText="Course hint · optional"/>
                        <ComboBox x:Name="LoginModeBox" x:Uid="LoginModeBox" Grid.Column="2"
                                  AutomationProperties.Name="Login mode"
                                  SelectedIndex="0"
                                  SelectionChanged="LoginMode_SelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem x:Uid="InteractiveLogin" Content="Interactive login" Tag="interactive"/>
                            <ComboBoxItem x:Uid="CredentialFill" Content="Credential Locker fill" Tag="saved"/>
                        </ComboBox>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="BrowserBackButton" Click="BrowserBack_Click"
                            ToolTipService.ToolTip="Back"
                            AutomationProperties.Name="Go back">
                        <FontIcon Glyph="&#xE72B;"/>
                    </Button>
                    <Button x:Uid="BrowserForwardButton" Grid.Column="1" Click="BrowserForward_Click"
                            ToolTipService.ToolTip="Forward"
                            AutomationProperties.Name="Go forward">
                        <FontIcon Glyph="&#xE72A;"/>
                    </Button>
                    <Button x:Uid="BrowserReloadButton" Grid.Column="2" Click="BrowserReload_Click"
                            ToolTipService.ToolTip="Reload"
                            AutomationProperties.Name="Reload page">
                        <FontIcon Glyph="&#xE72C;"/>
                    </Button>
                    <TextBox x:Name="AddressBox" x:Uid="AddressBox" Grid.Column="3"
                             PlaceholderText="https://your-school.example"
                             AutomationProperties.Name="Source address"
                             KeyDown="AddressBox_KeyDown"/>
                    <Button x:Uid="OpenAddressButton" Grid.Column="4" Content="Open"
                            Click="OpenAddress_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="CredentialButton" x:Uid="CredentialButton" Grid.Column="5"
                            Content="Credential"
                            Visibility="Collapsed"
                            Click="CredentialButton_Click"/>
                </Grid>

                <Border Grid.Row="3" CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <controls:WebView2 x:Name="Browser" x:Uid="SourceBrowser"
                                      AutomationProperties.Name="Source browser"
                                      NavigationStarting="Browser_NavigationStarting"
                                      NavigationCompleted="Browser_NavigationCompleted"/>
                </Border>

                <Grid Grid.Row="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BrowserTitle" x:Uid="BrowserTitle" Text="No page loaded"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BrowserLocation" Opacity="0.58"
                                   FontSize="12" MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <ToggleSwitch x:Name="AutoFillToggle" x:Uid="AutoFillToggle"
                                      Header="Auto-fill exact origin"
                                      Visibility="Collapsed"/>
                        <Button x:Name="ScanButton" x:Uid="ScanButton"
                                Content="Scan current page"
                                Click="ScanPage_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="15,9"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                <StackPanel Padding="28,22" Spacing="16" MaxWidth="760"
                            HorizontalAlignment="Left">
                    <TextBlock x:Uid="SettingsTitle" Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="NotificationsTitle" Text="System notifications" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="NotificationStatusText" x:Uid="NotificationStatusText"
                                       Text="Checking Windows settings…"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Uid="RefreshNotificationButton" Content="Refresh status"
                                        Click="RefreshNotificationStatus_Click"/>
                                <Button x:Uid="OpenNotificationSettingsButton" Content="Open notification settings"
                                        Click="OpenNotificationSettings_Click"/>
                                <Button x:Uid="SendTestNotificationButton" Content="Send test reminder"
                                        AutomationProperties.Name="Send a test reminder in five seconds"
                                        Click="SendTestNotification_Click"/>
                            </StackPanel>
                            <TextBlock x:Uid="NotificationHelp" Text="If notifications are blocked, tasks and reminder records continue to work normally."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="TaskDisplayTitle" Text="Task display" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="DisplayModeBox" x:Uid="DisplayModeBox"
                                      Header="Mode"
                                      SelectedIndex="0"
                                      SelectionChanged="DisplayMode_SelectionChanged">
                                <ComboBoxItem x:Uid="DisplaySimple" Content="Simple" Tag="simple"/>
                                <ComboBoxItem x:Uid="DisplayProfessional" Content="Professional" Tag="professional"/>
                            </ComboBox>
                            <TextBlock x:Uid="DisplayModeHelp" Text="Simple shows the title, course, due time, and status. Professional also shows the description, priority, and source link. Hidden fields are never cleared."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
                            <ComboBox x:Name="ThemeBox" x:Uid="ThemeBox"
                                      Header="Appearance"
                                      SelectedIndex="0"
                                      SelectionChanged="Theme_SelectionChanged">
                                <ComboBoxItem x:Uid="ThemeSystem" Content="Use system setting" Tag="system"/>
                                <ComboBoxItem x:Uid="ThemeLight" Content="Light" Tag="light"/>
                                <ComboBoxItem x:Uid="ThemeDark" Content="Dark" Tag="dark"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="LanguageSectionTitle"
                                       Text="Language" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="LanguageBox"
                                      x:Uid="LanguageBox"
                                      Header="Application language"
                                      SelectedIndex="0"
                                      SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem x:Uid="LanguageEnglish"
                                              Content="English"
                                              Tag="en-US"/>
                                <ComboBoxItem x:Uid="LanguageChinese"
                                              Content="Simplified Chinese"
                                              Tag="zh-CN"/>
                            </ComboBox>
                            <TextBlock x:Uid="LanguageHelp"
                                       Text="The interface updates immediately. Task data is not changed."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="LocalAiTitle" Text="Local AI" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="AiEndpointBox" x:Uid="AiEndpointBox"
                                     Header="Loopback endpoint"
                                     Text="http://127.0.0.1:8080"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Uid="CheckAiButton" Content="Check connection"
                                        Click="CheckAi_Click"/>
                                <TextBlock x:Name="AiStatusText" x:Uid="AiStatusText"
                                           Text="Not checked"
                                           VerticalAlignment="Center"
                                           Opacity="0.65"/>
                            </StackPanel>
                            <TextBlock x:Uid="AiHelp" Text="Only localhost and loopback IP addresses are accepted."
                                       FontSize="12" Opacity="0.58"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="LocalDataTitle" Text="Local data" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Uid="LocalDataHelp" Text="Task data stays in SQLite on this PC. Versioned migrations create a recoverable backup before changing an existing database."
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DatabaseVersionText"
                                       FontSize="12" Opacity="0.68"/>
                            <TextBlock x:Name="DatabasePathText"
                                       FontSize="11" Opacity="0.58"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="PrivacyTitle" Text="Privacy" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Uid="PrivacyPasswords" Text="• Passwords stay in Windows Credential Locker"/>
                            <TextBlock x:Uid="PrivacyContent" Text="• Course content stays on this PC"/>
                            <TextBlock x:Uid="PrivacyBrowser" Text="• The local model cannot control the login browser"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
