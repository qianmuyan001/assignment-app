<Application
    x:Class="AssignmentNative.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TaskCardBrush" Color="#FFFDFDFD"/>
                    <SolidColorBrush x:Key="TaskCardStrokeBrush" Color="#19000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TaskCardBrush" Color="#FF202124"/>
                    <SolidColorBrush x:Key="TaskCardStrokeBrush" Color="#2FFFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TaskCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource TaskCardStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="TaskCardStyle" TargetType="Border"
                   BasedOn="{StaticResource GlassCardStyle}"/>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
